<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{name}}</title>
  <link rel="stylesheet" href="assets/css/notebook.css">
</head>
<body data-signals="{currentSection:'', viewerSide:''}">
  <header class="notebook-header">
    <div class="header-logo">
      {{#if logo}}<img src="{{logo}}" alt="{{name}}" class="team-logo">{{/if}}
      <span class="logo-text">
        <strong>{{logoWordmark}}</strong>
        <span class="logo-divider">|</span>
        <span class="logo-year">{{year}}</span> BINDER
      </span>
    </div>
    <nav class="chapter-nav">
      {{#each chapters}}
        <a href="#{{id}}" class="nav-link">{{name}}</a>
      {{/each}}
    </nav>
  </header>

  <main class="notebook-main">
    <div class="scroll-pane">

      <div class="notebook-title-page">
        {{#if teamLabel}}<p class="chapter-eyebrow">{{teamLabel}}</p>{{/if}}
        <h1 class="title-page-name">{{logoWordmark}}</h1>
      </div>

      <div class="notebook-toc notebook-toc--{{tocSide}}"
        data-on-intersect__half="$viewerSide='{{tocSide}}'"
        data-on-intersect__full="$currentSection='toc'"
        data-on-intersect__exit="$viewerSide='';$currentSection=''"
      >
        <div class="toc-card">
          <h2 class="toc-title">Contents</h2>
          {{#each chapters}}
            <div class="toc-chapter">
              <a href="#{{id}}" class="toc-chapter-link">{{name}}</a>
              <ul class="toc-sections">
                {{#each sections}}
                  <li><a href="#{{id}}" class="toc-section-link">{{name}}</a></li>
                {{/each}}
              </ul>
            </div>
          {{/each}}
        </div>
      </div>

      {{#each chapters}}
        <div class="notebook-chapter" id="{{id}}">
          {{#each sections}}
            {{> section}}
          {{/each}}
        </div>
      {{/each}}

    </div>

    <div class="viewer-pane"
      data-class="{'viewer-pane--left': $viewerSide==='left', 'viewer-pane--right': $viewerSide==='right'}">
      <div class="viewer-wrapper">
        <notebook-viewer id="viewer" data-ref="viewer" src="{{model}}"
          facing="{{facing}}" elevation="{{elevation}}">
          {{#each annotations}}
            <notebook-annotation target="{{target}}" location="{{position}}"
              data-attr:hidden="$currentSection !== ''">
              <span slot="title">{{label}}</span>
              <span slot="body">{{description}}</span>
            </notebook-annotation>
          {{/each}}
          {{#each chapters}}
            {{#each sections}}
              {{#each annotations}}
                <notebook-annotation target="{{target}}" location="{{position}}"
                  data-attr:hidden="$currentSection !== '{{../id}}'">
                  <span slot="title">{{label}}</span>
                  <span slot="body">{{description}}</span>
                </notebook-annotation>
              {{/each}}
            {{/each}}
          {{/each}}
        </notebook-viewer>
      </div>
    </div>
  </main>

  <script type="module" src="/vendor/datastar.js"></script>
  <script type="module" src="/src/main.js"></script>
</body>
</html>
