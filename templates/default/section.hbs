<section id="{{id}}" class="notebook-section"
  data-on-intersect__full__debounce.50ms="{{setviewExpr}}"
  data-on-intersect__exit__debounce.50ms="$currentSection='';$viewer.dispatchEvent(new CustomEvent('showmeshes',{detail:{nodes:[]}}))"
  >
  <div class="section-card">
    <h3 class="section-title">{{chapterName}}:{{name}}</h3>
    {{#each features}}
      <div class="section-feature">{{this}}</div>
    {{/each}}
  </div>
</section>
